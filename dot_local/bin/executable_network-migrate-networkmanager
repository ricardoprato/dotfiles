#!/bin/bash
#
# network-migrate-networkmanager: one-shot switch of Wi-Fi from iwd to
# NetworkManager. Backs up iwd state, converts iwd profiles (PSK and open) to
# NetworkManager keyfiles, writes /etc/NetworkManager/conf.d/10-dotfiles.conf,
# swaps the services and rolls back to iwd if connectivity does not come up.
# Run by hand (needs sudo); idempotent. 802.1X profiles are not converted.
#
# Usage: network-migrate-networkmanager [--dry-run]

set -eEuo pipefail

IWD_STATE=/var/lib/iwd
IWD_CONF=/etc/iwd
NM_DIR=/etc/NetworkManager
NM_CONNS=$NM_DIR/system-connections
NM_CONF=$NM_DIR/conf.d/10-dotfiles.conf
WAIT_SECONDS=45
DRY_RUN=0
BACKUP_DIR=""
SWAPPING=0
ROLLING_BACK=0
TMP_DIR=""

log() { printf '==> %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}
plan() { printf '[dry-run] would %s\n' "$*"; }

usage() {
  echo "Usage: ${0##*/} [--dry-run]"
}

case "${1:-}" in
  "") ;;
  --dry-run) DRY_RUN=1 ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

as_root() {
  if ((EUID == 0)); then "$@"; else sudo "$@"; fi
}

cleanup() {
  [[ -n $TMP_DIR ]] && rm -rf "$TMP_DIR"
  return 0
}

rollback() {
  ((ROLLING_BACK)) && return 0
  ROLLING_BACK=1
  trap - ERR INT TERM
  set +e
  warn "rolling back to iwd"
  as_root systemctl disable --now NetworkManager
  as_root systemctl enable --now iwd
  warn "NetworkManager disabled, iwd re-enabled and started."
  warn "Keyfiles in $NM_CONNS and the backup in ${BACKUP_DIR:-<none>} were left in place."
  warn "Check 'journalctl -u NetworkManager -b' and re-run ${0##*/} to retry."
}

on_signal() {
  rollback
  exit 130
}

on_err() {
  local rc=$?
  ((SWAPPING)) && rollback
  exit "$rc"
}

trap cleanup EXIT
trap on_err ERR

# --- preconditions -----------------------------------------------------------

if [[ -r /proc/sys/kernel/osrelease ]] && grep -qi microsoft /proc/sys/kernel/osrelease; then
  die "WSL detected: this machine does not use iwd/NetworkManager. Nothing to do."
fi

if systemctl is-active --quiet NetworkManager && ! systemctl is-active --quiet iwd; then
  log "NetworkManager is already active and iwd is inactive. Nothing to do."
  exit 0
fi

if ! command -v NetworkManager >/dev/null 2>&1; then
  msg="NetworkManager is not installed. Run 'chezmoi apply' (installs the desktop package set) or install networkmanager, then re-run."
  if ((DRY_RUN)); then
    warn "$msg"
    warn "continuing because of --dry-run."
  else
    die "$msg"
  fi
fi

if ! pacman -Q wpa_supplicant >/dev/null 2>&1; then
  msg="wpa_supplicant is not installed (NetworkManager's Wi-Fi backend; a dependency of the networkmanager package)."
  if ((DRY_RUN)); then
    warn "$msg"
  else
    die "$msg Aborting before touching anything."
  fi
fi

if ! command -v iw >/dev/null 2>&1; then
  msg="iw is not installed (needed to recreate the Wi-Fi interface iwd removes on stop)."
  if ((DRY_RUN)); then
    warn "$msg"
  else
    die "$msg Aborting before touching anything."
  fi
fi

# --- helpers -----------------------------------------------------------------

# ini_get <section> <key>  (reads the file content from stdin)
ini_get() {
  awk -v sec="$1" -v key="$2" '
    /^\[.*\][[:space:]]*$/ { cur = substr($0, 2, index($0, "]") - 2); next }
    cur == sec {
      i = index($0, "=")
      if (i > 0 && substr($0, 1, i - 1) == key) { print substr($0, i + 1); exit }
    }'
}

# Escape a value for an NM keyfile string: backslash, and a leading space.
kf_escape() {
  local v=${1//\\/\\\\}
  [[ $v == " "* ]] && v="\\s${v# }"
  printf '%s' "$v"
}

# hex bytes -> raw bytes
hex_to_bytes() {
  local hex=$1 i
  for ((i = 0; i < ${#hex}; i += 2)); do
    printf %b "\\x${hex:i:2}"
  done
}

# hex bytes -> "104;101;" integer list (always valid for NM's ssid=)
hex_to_intlist() {
  local hex=$1 i out=""
  for ((i = 0; i < ${#hex}; i += 2)); do
    out+="$((16#${hex:i:2}));"
  done
  printf '%s' "$out"
}

# iwd file base name -> SSID as lowercase hex. Plain names are used as-is,
# names starting with '=' carry the SSID hex-encoded.
name_to_hex() {
  local name=$1
  if [[ $name == =* ]]; then
    printf '%s' "${name#=}" | tr 'A-F' 'a-f'
  else
    printf '%s' "$name" | od -An -v -tx1 | tr -d ' \n'
  fi
}

# Render the ssid= value: plain string when unambiguous, else byte list.
ssid_value() {
  local hex=$1 text
  text=$(hex_to_bytes "$hex"; printf x)
  text=${text%x}
  if [[ $text =~ ^[A-Za-z0-9_.-]([A-Za-z0-9\ _.-]*[A-Za-z0-9_.-])?$ && ! $text =~ ^[0-9]+$ ]]; then
    printf '%s' "$text"
  else
    hex_to_intlist "$hex"
  fi
}

new_uuid() {
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen
  else
    cat /proc/sys/kernel/random/uuid
  fi
}

# --- plan / dry run ----------------------------------------------------------

if ((DRY_RUN)); then
  log "dry-run: nothing is changed and no root-only file is read"
  plan "ask for sudo credentials once (sudo -v)"
  plan "back up $IWD_STATE and $IWD_CONF to /var/backups/iwd-<timestamp>/ (root:root 0700)"
  plan "read $IWD_STATE/*.psk and *.open (as root)"
  plan "write one NetworkManager keyfile per profile to $NM_CONNS/<name>.nmconnection (root:root 0600):"
  echo "      .psk  -> key-mgmt=wpa-psk, psk from Passphrase= or PreSharedKey="
  echo "      .open -> no [wifi-security] section"
  echo "      .8021x -> skipped with a warning"
  echo "      Hidden=true -> hidden=true, AutoConnect=false -> autoconnect=false"
  echo "      existing NM profile with the same id -> skipped"
  plan "remove interface-name= from Wi-Fi profiles in $NM_CONNS bound to an interface that no longer exists"
  plan "write $NM_CONF:"
  echo "      [main] dns=systemd-resolved"
  echo "      [keyfile] unmanaged-devices=interface-name:docker*;interface-name:br-*;interface-name:veth*;interface-name:virbr*"
  plan "systemctl disable --now iwd"
  plan "recreate a station interface (iw phy <phy> interface add) for every phy iwd left without one"
  plan "systemctl enable --now NetworkManager"
  plan "wait up to ${WAIT_SECONDS}s for 'nmcli -t -f STATE general' == connected and 'getent hosts archlinux.org'"
  plan "on failure or INT/ERR: systemctl disable --now NetworkManager; systemctl enable --now iwd (keyfiles and backup kept), exit 1"
  plan "print 'nmcli connection show' and the manual revert commands"
  exit 0
fi

# --- real run ----------------------------------------------------------------

log "requesting sudo credentials"
if ((EUID != 0)); then sudo -v; fi

TMP_DIR=$(mktemp -d)
chmod 700 "$TMP_DIR"

# 1. backup
BACKUP_DIR=/var/backups/iwd-$(date +%Y%m%d-%H%M%S)
log "backing up iwd state to $BACKUP_DIR"
as_root install -d -m 0700 -o root -g root "$BACKUP_DIR"
if as_root test -d "$IWD_STATE"; then as_root cp -a "$IWD_STATE" "$BACKUP_DIR/var-lib-iwd"; fi
if as_root test -d "$IWD_CONF"; then as_root cp -a "$IWD_CONF" "$BACKUP_DIR/etc-iwd"; fi
echo "backup: $BACKUP_DIR"

# 2. import profiles (before NetworkManager ever starts)
as_root install -d -m 0700 -o root -g root "$NM_CONNS"
imported=0
skipped=0
while IFS= read -r -d '' file; do
  base=${file##*/}
  ext=${base##*.}
  name=${base%.*}

  if [[ $ext == 8021x ]]; then
    warn "skipping 802.1X profile '$name' (not converted; kept in the backup)"
    skipped=$((skipped + 1))
    continue
  fi

  hex=$(name_to_hex "$name")
  if [[ -z $hex || ! $hex =~ ^([0-9a-f]{2})+$ ]]; then
    warn "skipping '$base': cannot decode SSID from file name"
    skipped=$((skipped + 1))
    continue
  fi
  id=$(hex_to_bytes "$hex" | LC_ALL=C tr -d '[:cntrl:]')
  [[ -n $id ]] || id="ssid-$hex"
  fname=$(printf '%s' "$id" | LC_ALL=C tr -c 'A-Za-z0-9 _.-' '_')
  dest=$NM_CONNS/$fname.nmconnection

  if as_root test -e "$dest" || as_root grep -qsxF "id=$(kf_escape "$id")" "$NM_CONNS"/*.nmconnection 2>/dev/null; then
    echo "skipped: '$id' (a NetworkManager profile with this id already exists)"
    skipped=$((skipped + 1))
    continue
  fi

  content=$(as_root cat "$file")
  autoconnect=true
  [[ $(ini_get Settings AutoConnect <<<"$content") == false ]] && autoconnect=false
  hidden=""
  [[ $(ini_get Settings Hidden <<<"$content") == true ]] && hidden="hidden=true"

  security=""
  if [[ $ext == psk ]]; then
    pass=$(ini_get Security Passphrase <<<"$content")
    rawpsk=$(ini_get Security PreSharedKey <<<"$content")
    if [[ -n $pass ]]; then
      security=$'\n[wifi-security]\nkey-mgmt=wpa-psk\npsk='$(kf_escape "$pass")
    elif [[ $rawpsk =~ ^[0-9a-fA-F]{64}$ ]]; then
      security=$'\n[wifi-security]\nkey-mgmt=wpa-psk\npsk='$rawpsk
    else
      warn "skipping '$id': no usable Passphrase/PreSharedKey in $base"
      skipped=$((skipped + 1))
      continue
    fi
  elif [[ $ext != open ]]; then
    warn "skipping '$base': unknown profile type"
    skipped=$((skipped + 1))
    continue
  fi

  tmp=$TMP_DIR/profile
  (
    umask 077
    {
      printf '[connection]\nid=%s\nuuid=%s\ntype=wifi\nautoconnect=%s\n\n' \
        "$(kf_escape "$id")" "$(new_uuid)" "$autoconnect"
      printf '[wifi]\nmode=infrastructure\nssid=%s\n' "$(ssid_value "$hex")"
      [[ -n $hidden ]] && printf '%s\n' "$hidden"
      [[ -n $security ]] && printf '%s\n' "$security"
      printf '\n[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
    } >"$tmp"
  )
  as_root install -o root -g root -m 0600 "$tmp" "$dest"
  rm -f "$tmp"
  echo "imported: '$id' -> $dest"
  imported=$((imported + 1))
done < <(as_root find "$IWD_STATE" -maxdepth 1 -type f \( -name '*.psk' -o -name '*.open' -o -name '*.8021x' \) -print0 2>/dev/null)
log "profiles imported: $imported, skipped: $skipped"

# Profiles left from an earlier NetworkManager install can be pinned to an
# interface name that no longer exists (wlp3s0 before iwd's link file kept the
# kernel's wlan0). NetworkManager never activates those, so unpin them.
log "unpinning Wi-Fi profiles bound to a missing interface"
# shellcheck disable=SC2016  # expanded by the root shell, not here
as_root bash -c '
  for f in "$1"/*.nmconnection; do
    [[ -e $f ]] || continue
    grep -qx "type=wifi" "$f" || continue
    ifn=$(sed -n "s/^interface-name=//p" "$f")
    [[ -n $ifn && ! -e /sys/class/net/$ifn ]] || continue
    sed -i "/^interface-name=/d" "$f"
    echo "unpinned: ${f##*/} (interface $ifn no longer exists)"
  done' _ "$NM_CONNS"

# 3. NetworkManager configuration
log "writing $NM_CONF"
cat >"$TMP_DIR/10-dotfiles.conf" <<'CONF'
# Written by network-migrate-networkmanager (dotfiles). Re-running the script
# rewrites this file.
[main]
dns=systemd-resolved

[keyfile]
unmanaged-devices=interface-name:docker*;interface-name:br-*;interface-name:veth*;interface-name:virbr*
CONF
as_root install -d -m 0755 -o root -g root "$NM_DIR/conf.d"
as_root install -o root -g root -m 0644 "$TMP_DIR/10-dotfiles.conf" "$NM_CONF"

# 4. swap services, with automatic rollback
trap on_signal INT TERM
SWAPPING=1
log "swapping iwd -> NetworkManager"
as_root systemctl disable --now iwd
# iwd deletes the wireless netdevs it manages when it stops, and the kernel can
# finish that after iwd has already exited. Give it a moment, then recreate a
# station interface for every phy left without one, or NetworkManager finds no
# Wi-Fi device.
ensure_wifi_netdevs() {
  local phy
  for phy in /sys/class/ieee80211/*; do
    [[ -e $phy ]] || continue
    if ! compgen -G "$phy/device/net/*" >/dev/null; then
      log "recreating station interface on ${phy##*/}"
      as_root iw phy "${phy##*/}" interface add "wlan${phy##*phy}" type station
    fi
  done
}
sleep 2
ensure_wifi_netdevs
as_root systemctl enable --now NetworkManager

# Belt and braces: if NetworkManager still lists no Wi-Fi device, the netdev
# vanished after the check above. Recreate it; NetworkManager picks it up.
for ((i = 0; i < 10; i++)); do
  nmcli -t -f TYPE device 2>/dev/null | grep -qx wifi && break
  sleep 1
done
if ! nmcli -t -f TYPE device 2>/dev/null | grep -qx wifi; then
  warn "NetworkManager sees no Wi-Fi device yet"
  ensure_wifi_netdevs
fi

log "waiting up to ${WAIT_SECONDS}s for connectivity"
ok=0
for ((i = 0; i < WAIT_SECONDS; i++)); do
  state=$(nmcli -t -f STATE general 2>/dev/null || true)
  if [[ $state == connected ]] && getent hosts archlinux.org >/dev/null 2>&1; then
    ok=1
    break
  fi
  sleep 1
done

if ((!ok)); then
  warn "no connectivity after ${WAIT_SECONDS}s (state: ${state:-unknown})"
  rollback
  exit 1
fi
SWAPPING=0
trap - ERR INT TERM

# 5. report
log "NetworkManager is connected"
nmcli connection show
cat <<NOTE

Note: iwd is now stopped and disabled, so impala no longer works; use nmtui
(launch-wifi picks it automatically). Backup: $BACKUP_DIR

Manual revert:
  sudo systemctl disable --now NetworkManager
  sudo systemctl enable --now iwd
NOTE
