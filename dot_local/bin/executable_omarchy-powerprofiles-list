#!/bin/bash
# Override of upstream bin/omarchy-powerprofiles-list (basecamp/omarchy @ 3ac43659), whole-file replacement.
# Modified copy of an Omarchy file: MIT, (c) David Heinemeier Hansson; see NOTICE.
# Why: powerprofilesctl pinned to /usr/bin (mise python lacks gi). Pin entry: .chezmoidata/omarchy.toml

# omarchy:summary=Returns a list of all the available power profiles on the system.
# omarchy:args=[--active-state]

# powerprofilesctl is `#!/usr/bin/env python3` and needs the system python (gi);
# a mise python earlier in PATH lacks it. Put the system dirs first for the call.
powerprofilesctl() {
  PATH=/usr/bin:$PATH command powerprofilesctl "$@"
}

if [[ ${1:-} != "" && ${1:-} != "--active-state" ]]; then
  echo "Usage: omarchy-powerprofiles-list [--active-state]" >&2
  exit 1
fi

powerprofilesctl list 2>/dev/null |
  awk -v with_state="${1:+1}" '/^\s*[* ]\s*[a-zA-Z0-9-]+:$/ {
    active = ($1 == "*") ? 1 : 0
    gsub(/^[*[:space:]]+|:$/, "")
    print $0 (with_state ? "\t" active : "")
  }' |
  tac
