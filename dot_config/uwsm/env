# Changes require a restart to take effect.

# OMARCHY_PATH is the pinned upstream omarchy external (bin/, default/, shell/,
# config/ seeds, themes/); theming state lives in ~/.local/state/omarchy/current.
# See odd/tasks/omarchy-upstream-overlay.md.
export OMARCHY_PATH=$HOME/.local/share/omarchy-upstream

# Command lookup: personal overrides and our own scripts (~/.local/bin) first,
# then the pinned upstream omarchy external's bin/. The session PATH reaches
# Hyprland (hypr/envs.lua sets none) and the systemd user manager (uwsm imports
# this file's exports).
export PATH=$HOME/.local/bin:$HOME/.local/share/omarchy-upstream/bin:$PATH

# OCR languages for omarchy-capture-text (tesseract -l). Requires
# tesseract-data-<lang> installed per language.
export OMARCHY_OCR_LANGS=eng+spa

# Weather location is no longer an env var: the shell weather panel and
# omarchy-weather-{status,icon} read ~/.local/state/omarchy/settings/weather.json
# (seeded once by chezmoi with Buenos Aires; wttr.in geo-IP misresolves this
# connection to the US, see chubin/wttr.in#599). Change it with
# `omarchy-weather-location --set <name> [lat,lon]`.

# Input method (fcitx5 + mozc for Japanese; passthrough for normal latam typing).
# GTK_IM_MODULE intentionally omitted: GTK4 uses native Wayland IME protocol;
# setting it forces the legacy path and breaks GTK4 apps.
# Electron/Chromium: see *-flags.conf (--enable-wayland-ime).
export XMODIFIERS=@im=fcitx
export QT_IM_MODULE=fcitx
export SDL_IM_MODULE=fcitx
export GLFW_IM_MODULE=ibus

# Set default terminal and editor
source ~/.config/uwsm/default

# Mise activation moved out of the session env: shims-at-front-of-PATH was
# breaking system scripts with `#!/usr/bin/env python3` (e.g. powerprofilesctl
# in /bin needs system Python's `gi` module — mise's bundled Python lacks it).
#
# Mise now activates per-shell via:
#   - fish: dot_config/fish/conf.d/mise.fish
#   - other shells: add `mise activate <shell> | source` to their rc.
#
# Inside a directory with .mise.toml the shell-level hook prepends the right
# tool versions. Non-interactive contexts (the shell, hyprland exec_on_start,
# systemd user services) see only the system PATH — which is what they want.
