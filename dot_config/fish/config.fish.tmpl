set -g fish_greeting

if status is-interactive
    fish_vi_key_bindings
    # starship has no include mechanism: the whole config is the user template
    # ~/.config/omarchy/themed/starship.toml.tpl, rendered per theme.
    set -gx STARSHIP_CONFIG ~/.local/state/omarchy/current/theme/starship.toml
    starship init fish | source
    atuin init fish | source
    eval "$(direnv hook fish)"
end

# List Directory
alias l='eza -lh  --icons=auto' # long list
alias ls='eza -1   --icons=auto' # short list
alias ll='eza -lha --icons=auto --sort=name --group-directories-first' # long list all
alias ld='eza -lhD --icons=auto' # long list dirs
alias lt='eza --icons=auto --tree' # list folder as tree
alias cd='z' # list folder as tree

# Handy change dir shortcuts
abbr .. 'cd ..'
abbr ... 'cd ../..'
abbr .3 'cd ../../..'
abbr .4 'cd ../../../..'
abbr .5 'cd ../../../../..'

# Always mkdir a path (this doesn't inhibit functionality to make a single dir)
abbr mkdir 'mkdir -p'

# pnpm
set -gx PNPM_HOME "$HOME/.local/share/pnpm"
if not string match -q -- "$PNPM_HOME/bin" $PATH
  set -gx PATH "$PNPM_HOME/bin" $PATH
end
# pnpm end
